# PostgreSQL database connection string
# Local example:
# DATABASE_URL=postgresql://username:password@localhost:5432/smartops

DATABASE_URL=postgresql://username:password@localhost:5432/smartops

# Comma-separated frontend URLs allowed to call the FastAPI backend
# Local example:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret key used to sign JWT access tokens
# Production should use a long, secure random value
# Local example:
# SECRET_KEY=dev-secret-key-change-this

SECRET_KEY=dev-secret-key-change-this
